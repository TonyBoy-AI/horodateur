{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Horodateur",
  "version": "0.3.6",
  "identifier": "com.anthony.horodateur",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Horodateur 🌿",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3RUIyMzNENDNGMkU0NDkKUldSSjVQSkRQU1ByUjJmVUFZV2RTQjVscHl5SHM0WlM2di9EdUZuYVRBRDZBMjQwaUJ2OWtWbmcK",
      "endpoints": [
        "https://github.com/TonyBoy-AI/horodateur/releases/latest/download/latest.json"
      ]
    }
  }
}
